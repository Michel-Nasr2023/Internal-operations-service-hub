# Copy to backend/.env and fill in. Never commit backend/.env.

# Signs session tokens. Use a long random string; without it everyone is signed out on every restart.
AUTH_SECRET=change-me-to-a-long-random-string

# AI ticket analysis (Requesty, OpenAI-compatible)
RQSTY_API_KEY=
RQSTY_API_URL=https://router.requesty.ai/v1/chat/completions
RQSTY_MODEL=nvidia/nemotron-3-super-120b-a12b
# RQSTY_TIMEOUT_MS=90000

# Address of the frontend, used in links inside emails
APP_URL=http://localhost:5173

# Outgoing email (password reset codes, invitations). Leave SMTP_HOST empty to keep emails in the
# Admin > System outbox instead of sending them.
#
# Gmail:            SMTP_HOST=smtp.gmail.com       SMTP_PORT=465  (SMTP_PASS = a Google "App password")
# Outlook / M365:   SMTP_HOST=smtp.office365.com   SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # defaults to true on port 465, STARTTLS otherwise
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Internal Operations Service Hub <you@example.com>"

# Optional
# Folder for the database, attachments, profile photos and backups (default: backend/data). Moving it out of
# a synced folder such as OneDrive avoids the sync client locking the database file.
# DATA_DIR=C:/ServiceHubData
# NOTIFICATION_CHECK_INTERVAL_MS=300000
# ATTACHMENTS_DIR=data/attachments
# AVATARS_DIR=data/avatars
