# Caddy serves the web app and forwards /api to the API on this machine, with automatic HTTPS.
# Copy to /etc/caddy/Caddyfile and replace your-hub.duckdns.org with your own domain.
your-hub.duckdns.org {
	encode gzip

	# Attachments: up to 5 files of 10 MB in one upload.
	request_body {
		max_size 60MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# The React app; unknown paths (e.g. the reset link /?reset=...) load index.html.
	handle {
		root * /srv/service-hub/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
